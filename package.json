{
  "name": "bunki",
  "version": "0.0.0",
  "private": true,
  "description": "Bunki (分岐) — Phase-0 closed learning loop. Monorepo root (WP-01).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:replay": "vitest run packages/domain/test/replay",
    "test:e2e": "playwright test --config apps/app/e2e/playwright.config.ts",
    "test:e2e:build": "npm run export:web --workspace @bunki/app",
    "verify:export": "vitest run packages/export/test/verify-export.test.ts",
    "bunki:web:dev": "npm --prefix prototypes/bunki-sites-v11 run dev -- --host 0.0.0.0",
    "bunki:web:build": "npm --prefix prototypes/bunki-sites-v11 run build",
    "bunki:web:test": "npm --prefix prototypes/bunki-sites-v11 run test:unit",
    "bunki:web:e2e": "npm --prefix prototypes/bunki-sites-v11 run test:e2e",
    "bunki:web:deploy": "npm --prefix prototypes/bunki-sites-v11 run deploy:worker"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.0",
    "eslint": "10.8.0",
    "playwright-core": "1.56.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
