  "harnessContract": {
    "isolation": "Run every scenario, and every four-ratings variant, with fresh in-memory stores and a fresh fake canonical permit authority. Never share projection objects or installation ids between runs.",
    "registryTranslation": {
      "tasks": "For each cards row, pass taskKey, noteGuid, contractId, passageId, and lexemeId unchanged.",
      "notes": "Create one {noteGuid,module} row per card.",
      "passages": [],
      "examples": [],
      "catalog": "Pass each complete card row to createReplicaBackend; translationVerified:true makes it content-ready. Presentation text is synthetic and is not a task identity."
    },
    "construction": [
      "Load client/vendor/fsrs-pin.json and construct createStudyEngine({content:{registry,pin,catalog},learner:'test-shared-srs',epoch:0,timezone:'Asia/Tokyo'}) from the canonical facade imported by the Bunki adapter.",
      "Use engine.createFreshStore with memory adapters, the real payloadHash/canonicalStringify/validateEvent codec, fixed now, and the scoped installation id; materialize through engine.replay.",
      "Construct the canonical consumer through engine.connect({store,now,uuid}) and the Bunki consumer through createBunkiStudyAdapter for each device. Deterministic synthetic uuid sequences are allowed.",
      "All durable commands must be produced by the real store/backend. The synthetic permit authority uses the documented test grant pattern with real event validation and payloadHash. Do not mutate projections or inject effectiveRating."
    ],
    "operations": {
      "reservePermits": "For the selected device, derive the current learner-day limit and allocated count with the real studyDayAllowance/projection at the fixed clock. The synthetic authority grants exactly count permits when within budget, otherwise returns daily-permit-budget without an envelope; reconcile a real validated grant into that store and refresh. The authority result is saved when 'as' is present.",
      "syncAll": "Converge both stores on the identical complete canonical prefix through store.reconcile, then backend.refresh on both. No transport or production service is used.",
      "snapshotAttempt": "Call backend.snapshotAttempt(cards[card].taskKey,options) and save the frozen attempt as 'as'.",
      "preview": "Call backend.preview(savedAttempt,thinkMs) and save the four alternatives as 'as'.",
      "submitPreview": "Call backend.submitCommand(savedPreview.intents[rating]) exactly once and save the result.",
      "makeReviewCommand": "Call backend.reviewData(savedAttempt,rating,thinkMs), then backend.command('review',data); save the immutable command. If expectError is present, reviewData must throw that exact message and no command is created.",
      "submitCommand": "Call backend.submitCommand(savedCommand) and save the result.",
      "submitChangedRetry": "Call backend.submitCommand({...savedCommand,ts:savedCommand.ts+1}) with the same commandId and save the result.",
      "mutate": "Resolve $result.eventId references, then call backend.mutate(type,cards[card].taskKey,data) and save the result.",
      "practice": "Call backend.practice(savedAttempt,rating,thinkMs) and save the result.",
      "capture": "Resolve attempt/card references and call backend.capture(savedAttempt,capture); save the result.",
      "checkpoint": "Save structured clones of backend.readProjection(), await store.status(), and store.head/applied cursors for the selected device under 'as'."
    },
    "references": "Card ids index the cards array. $rating selects the current variant. $name.eventId reads a saved result. Capture contextTaskKey/targetTaskKey come from the named card and contentRevision from the saved attempt.",
    "invariants": {
      "result": "The saved result has exactly the requested kind and, when supplied, reason.",
      "reviewCount": "The selected device's final projection.reviews.length equals value.",
      "reviewRating": "The sole final review has rawRating and effectiveRating equal to the requested values; no client-provided effectiveRating is used.",
      "previewMatchesCommitted": "The result event identifies the sole review; final tasks[card].card deep-equals preview.cards[rating], and review effectiveRating/at deep-equal preview.ratings[rating].",
      "permitUse": "Count final permits for the device installation whose usedBy is non-null; optionally also assert the total permits issued to that installation.",
      "undoRestoresNewCard": "The reviewed card is null and its head is undo.eventId; the original review remains with non-null undoneAt; the original permit remains spent on the original review; no review or capture is deleted.",
      "sharedBudget": "For the fixed learner day, studyDayAllowance/backend.todayAllowance on both devices reports limit=20, allocated permitGrants total 20, and used/unused permit counts per installation match the requested values.",
      "sameEvent": "Two saved results have identical eventId, dseq, and eventTs; final reviewCount is one and locallyDurable is unchanged from the checkpoint taken after the first submission.",
      "noNewDurableEvent": "The checkpoint and final store have identical head, locallyDurable, canonical count, and local count.",
      "localEventDelta": "The selected store's locallyDurable minus the checkpoint value equals value; observation outcomes can therefore be durable without becoming reviews.",
      "noScheduleMutation": "Deep-compare checkpoint versus final projection tasks, reviews, permits, introductions, and boostSources. Captures, attempts, outcomes, and observations are intentionally excluded.",
      "captureCount": "The final projection.captures.length equals value.",
      "practiceEvidence": "The durable submitted review attempt has mode='practice', revealed=true, helpBeforeAnswer=false; its outcome reason is practice-or-assisted.",
      "crossHostParity": "After each scenario, independently replay/compare on every host adapter: deep-equal the complete scheduled card JSON, raw/effective rating and effective at, outcome disposition/reason, permit consumption, captures, reviews, and undo markers. Do not mask due, stability, difficulty, or state differences."
    },
    "numericExpectations": "No exact FSRS due, stability, difficulty, elapsed-day, or scheduled-day value is pinned. Expected card values come only from backend.preview executing the pinned canonical engine in the same fresh run; cross-host checks compare complete measured values."
  },
