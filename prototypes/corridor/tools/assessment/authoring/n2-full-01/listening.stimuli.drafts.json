    "roles": {
      "narrator": "案内・質問・選択肢番号。実際の声は未割当。",
      "announcer": "四つの活動や講座の条件を案内する話者。",
      "speaker-a": "企画担当者Ａ",
      "speaker-b": "企画担当者Ｂ",
