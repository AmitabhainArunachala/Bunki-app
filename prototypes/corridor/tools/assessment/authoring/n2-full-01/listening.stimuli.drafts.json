    },
    "questionItems": [
      {
        "kind": "item",
        "id": "kairo-original-jlpt-n2-form-01:l25",
        "revisionId": "assessment-item:3d8428a0a081eecc3bcdb95759d55ee1e1cfad8d0a7d17c6b9a743306ca70d24",
        "sha256": "3d8428a0a081eecc3bcdb95759d55ee1e1cfad8d0a7d17c6b9a743306ca70d24"
      }
    ],
    "constraints": [
      "来場者自身が試せる",
      "外部講師は来られない",
      "通信が不安定",
      "新装置の準備期間がない",
      "手元の材料で職員が実施できる"
    ],
    "cues": [
      {
        "kind": "speech",
        "role": "stimulus-context",
        "voice": "narrator",
        "text": "科学館の担当者三人が、来月の短い体験企画について話しています。"
      },
      {
        "kind": "speech",
        "role": "shared-stimulus-dialogue",
        "voice": "speaker-a",
        "text": "来月の企画ですが、来場者が見るだけでなく、自分で確かめられるものにしたいですね。外部の先生に来てもらう講演はどうでしょう。",
        "authoredDialogueIndex": 0
      },
      {
        "kind": "speech",
        "role": "shared-stimulus-dialogue",
        "voice": "speaker-b",
        "text": "候補の先生はその日海外だそうです。オンラインなら可能だと言われましたが、この部屋は通信が安定していません。",
        "authoredDialogueIndex": 1
      },
      {
        "kind": "speech",
        "role": "shared-stimulus-dialogue",
        "voice": "speaker-c",
        "text": "録画した実験の映像を流すだけなら、通信は必要ありません。ただ、来場者からの質問に答えたり、条件を変えて試したりはできませんね。",
        "authoredDialogueIndex": 2
      },
      {
        "kind": "speech",
        "role": "shared-stimulus-dialogue",
        "voice": "speaker-a",
        "text": "準備期間も三日しかありません。新しい装置を作るのは難しいでしょう。",
        "authoredDialogueIndex": 3
      },
      {
        "kind": "speech",
        "role": "shared-stimulus-dialogue",
        "voice": "speaker-b",
        "text": "職員が普段の道具を使って、簡単な音の実験をするのはどうですか。材料はもうあります。最初にやり方を見せれば、来場者にも試してもらえます。",
        "authoredDialogueIndex": 4
      },
      {
        "kind": "speech",
        "role": "shared-stimulus-dialogue",
        "voice": "speaker-c",
        "text": "それなら一回二十分でできますね。外部の人や通信に頼らなくてもよい。",
        "authoredDialogueIndex": 5
      },
      {
        "kind": "speech",
        "role": "shared-stimulus-dialogue",
        "voice": "speaker-a",
        "text": "では、来場者自身が試せる、その方向で進めましょう。映像だけの企画は別の機会に考えます。",
        "authoredDialogueIndex": 6
      }
    ],
    "text": "narrator: 科学館の担当者三人が、来月の短い体験企画について話しています。\nspeaker-a: 来月の企画ですが、来場者が見るだけでなく、自分で確かめられるものにしたいですね。外部の先生に来てもらう講演はどうでしょう。\nspeaker-b: 候補の先生はその日海外だそうです。オンラインなら可能だと言われましたが、この部屋は通信が安定していません。\nspeaker-c: 録画した実験の映像を流すだけなら、通信は必要ありません。ただ、来場者からの質問に答えたり、条件を変えて試したりはできませんね。\nspeaker-a: 準備期間も三日しかありません。新しい装置を作るのは難しいでしょう。\nspeaker-b: 職員が普段の道具を使って、簡単な音の実験をするのはどうですか。材料はもうあります。最初にやり方を見せれば、来場者にも試してもらえます。\nspeaker-c: それなら一回二十分でできますね。外部の人や通信に頼らなくてもよい。\nspeaker-a: では、来場者自身が試せる、その方向で進めましょう。映像だけの企画は別の機会に考えます。\n",
    "textSha256": "fb313ce9b0a7b8f0287398ca9e4e13fa210fa91dffd0654d96ffc1705c87c873",
    "authorityBoundary": "Original authoring envelope only. Not a PassageVersion, MediaVersion, installed playback unit or permission to play.",
