{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunki.local/schemas/inquiry-unit-draft-v1.json",
  "title": "Inquiry thread draft manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "version",
    "draft_date",
    "frozen",
    "freeze_date",
    "author_family",
    "unit_count",
    "thread_count",
    "j11_example_thread_id",
    "write_set",
    "units"
  ],
  "properties": {
    "manifest": { "const": "inquiry" },
    "version": { "const": 1 },
    "draft_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "frozen": { "const": false },
    "freeze_date": { "type": "null" },
    "author_family": { "const": "moonshot" },
    "unit_count": { "type": "integer", "minimum": 1 },
    "thread_count": { "type": "integer", "minimum": 1 },
    "j11_example_thread_id": { "type": "string", "minLength": 1 },
    "write_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "thread_id",
        "title",
        "outcomes",
        "prerequisites",
        "review_obligations",
        "assessments",
        "sources",
        "compounding_obligations",
        "schedule_key"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^inquiry:unit:[a-z0-9][a-z0-9:-]*$" },
        "thread_id": { "type": "string", "minLength": 1, "pattern": "^inquiry:thread:[a-z0-9][a-z0-9:-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outcome" }
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "review_obligations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reviewObligation" }
        },
        "assessments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assessment" }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "compounding_obligations": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/compoundingObligation" }
        },
        "schedule_key": { "type": "null" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["can-do", "inquiry"] },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "reviewObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_class", "check"],
      "properties": {
        "actor_class": { "type": "string", "minLength": 1 },
        "check": { "type": "string", "minLength": 1 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_type", "item_ids"],
      "properties": {
        "check_type": { "type": "string", "minLength": 1 },
        "item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^inquiry:item:[a-z0-9][a-z0-9:-]*$" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "route"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^source:[a-z0-9][a-z0-9-]*$" },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "pattern": "^S3-R8: .+" }
      }
    },
    "compoundingObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "check", "source_id", "evidence_store"],
      "properties": {
        "step": {
          "enum": [
            "earlier_reading_record",
            "later_linked_evidence",
            "change_with_reason",
            "transfer_evidence"
          ]
        },
        "check": { "type": "string", "minLength": 1 },
        "source_id": { "type": ["string", "null"] },
        "evidence_store": { "type": "string", "minLength": 1 }
      }
    }
  }
}
