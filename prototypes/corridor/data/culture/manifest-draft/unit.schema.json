{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunki.local/schema/culture/unit.schema.json",
  "title": "Culture inventory unit (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "outcomes",
    "prerequisites",
    "review_obligations",
    "assessments",
    "evidence_status",
    "sources",
    "review_rubric_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^culture:unit:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "できる。$"
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^culture:unit:[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "review_obligations": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": [
          "actor_class"
        ],
        "properties": {
          "actor_class": {
            "const": "native-reviewer"
          }
        }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_class",
          "check"
        ],
        "properties": {
          "actor_class": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_type",
          "item_ids"
        ],
        "properties": {
          "check_type": {
            "type": "string",
            "minLength": 1
          },
          "item_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^culture:item:[a-z0-9]+(?:-[a-z0-9]+)*:[0-9]{2}$"
            }
          }
        }
      }
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "attested-history",
        "mnemonic",
        "uncertain-etymology"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "citation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "citation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review_rubric_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^culture:rubric:[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
