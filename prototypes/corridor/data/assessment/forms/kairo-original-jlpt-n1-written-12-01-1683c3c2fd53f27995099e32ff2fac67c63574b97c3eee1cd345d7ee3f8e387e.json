          {
            "id": "choice-3",
            "text": "最短の経路をたどったため、町のごく一部しか通らなかったということ"
          },
          {
            "id": "choice-4",
            "text": "実際の町は、画面で見るよりもはるかに複雑だったということ"
          }
        ],
        "answerOptionId": "choice-2"
      },
