1,"n5":0.492,"oov":0.3},"coverage":0.7,"n_content_tokens":130},"jreadability":{"band":"初級後半","in_scale":true,"score":5.5},"substrates":"jreadability-1.1.5/unidic-lite-2.1.2 + open-anki-jlpt-decks/wbig-6687 (build_articles.jlpt_signal, reading_facets 85% rule)"},"gradingBand":"jreadability 初級後半 (5.50); JLPT-lexicon facet N4, coverage 70%","id":"bunki-orig-n5-grandma-birthday","level":"N5","licence":"Bunki original (owner's copyright; repo licence applies)","licenceEvidence":"Written for Bunki on 2026-10-03 by a Claude curator helper; no third-party text used.","opening":"今日は十月八日です。おばあちゃんのたんじょう日です。おばあちゃんは、今日で七十五さいになりました。","part":null,"source":"bunki-original","textFile":"texts/bunki-orig-n5-grandma-birthday.txt","title":"おばあちゃんのたんじょう日","titleEn":"Grandma's Birthday Call","url":"","why":"A funny phone-call story in which the grandmother turns out to be livelier than anyone."},"readingFacets":{"forms":["ありがとう","いい","いう","いえ","いちばん","いっしょ","いる","うた","うたう","おもう","おわる","かえり道","かける","げんき","こえ","ごめん","しずか","しんぱい","じゃあ","すき","する","そう","そして","たくさん","たんじょう","だいじょうぶ","つぎ","とおい","とても","となり","ど","なる","はずかしい","ばあ","ばん","ふろ","ぼく","また","まだまだ","むこう","めでたい","もう","よる","れんしゅう","わらう","カラオケ","ハッピー","バースデー","一人","中","今日","出る","前","友だち","大きい","学校","少し","日","時","時間","月","来年","母","行く","言う","週間","長い","電話"],"jlpt":"N4","method":"bundled-vocabulary-85-percent;known-kanji-90-percent;source-and-text-topics/1","schoolGrade":"2","topics":[]},"rubySource":"tokenizer","source":"bunki-original","sourceLabel":"Bunki original story","text":"今日は十月八日です。おばあちゃんのたんじょう日です。おばあちゃんは、今日で七十五さいになりました。\n\nおばあちゃんは、ほっかいどうに一人ですんでいます。ぼくのいえから、とてもとおいです。ですから、ぼくは電話で「おめでとう」と言います。\n\nぼくは一週間前から、うたのれんしゅうをしました。「ハッピーバースデー」のうたです。おふろの中でも、学校のかえり道でも、たくさんうたいました。\n\nよる七時に、電話をかけました。でも、おばあちゃんは出ません。\n\n八時に、もういちどかけました。また出ません。\n\n「お母さん、おばあちゃん、だいじょうぶかな」\n\nお母さんも、少ししんぱいしていました。\n\n九時に、電話がなりました。おばあちゃんでした。\n\n「ごめん、ごめん。友だちとカラオケに行っていたのよ。三時間もうたったの」\n\nおばあちゃんのこえは大きくて、とてもげんきでした。\n\nぼくは「おたんじょう日、おめでとう」と言って、うたをうたいました。一週間れんしゅうしたうたです。少しはずかしかったです。\n\nうたがおわりました。電話のむこうは、しずかでした。\n\n「おばあちゃん？」\n\n「……ありがとう。いいうただね。じゃあ、つぎはおばあちゃんのばんね」\n\nそして、おばあちゃんは、カラオケでいちばんすきなうたをうたいました。ぼくより大きいこえで、ぼくより長くうたいました。\n\nお母さんは、となりでわらっていました。\n\n「おばあちゃんは、まだまだだいじょうぶね」\n\nぼくも、そうおもいます。来年のたんじょう日には、おばあちゃんのいえへ行きたいです。そして、いっしょにカラオケに行きたいです。\n","textMetrics":{"charsUnit":"unicode-codepoint","readingAnchorUnit":"utf16","tokenPositionUnit":"token-index","utf16Length":685},"title":"おばあちゃんのたんじょう日","titleEn":"Grandma's Birthday Call","tokens":[{"b":"今日","c":true,"f":[{"r":"きょう","t":"今日"}],"p":"名詞","r":"きょう","s":"今日"},{"b":"は","c":false,"f":[{"t":"は"}],"p":"助詞","r":"は","s":"は"},{"b":"十","c":false,"f":[{"r":"じゅう","t":"十"}],"p":"名詞","r":"じゅう","s":"十"},{"b":"月","c":true,"f":[{"r":"がつ","t":"月"}],"p":"名詞","r":"がつ","s":"月"},{"b":"八","c":false,"f":[{"r":"よう","t":"八"}],"p":"名詞","r":"よう","s":"八"},{"b":"日","c":false,"f":[{"r":"か","t":"日"}],"p":"接尾辞","r":"か","s":"日"},{"b":"です","c":false,"f":[{"t":"です"}],"p":"助動詞","r":"です","s":"です"},{"b":"。","c":false,"f":[{"t":"。"}],"p":"補助記号","r":"","s":"。"},{"b":"お","c":false,"f":[{"t":"お"}],"p":"接頭辞","r":"お","s":"お"},{"b":"ばあ","c":true,"f":[{"t":"ばあ"}],"p":"名詞","r":"ばあ","s":"ばあ"},{"b":"ちゃん","c":false,"f":[{"t":"ちゃん"}],"p":"接尾辞","r":"ちゃん","s":"ちゃん"},{"b":"の","c":false,"f":[{"t":"の"}],"p":"助詞","r":"の","s":"の"},{"b":"たんじょう","c":true,"f":[{"t":"たんじょう"}],"p":"名詞","r":"たんじょう","s":"たんじょう"},{"b":"日","c":true,"f":[{"r":"ひ","t":"日"}],"p":"名詞","r":"ひ","s":"日"},{"b":"です","c":false,"f":[{"t":"です"}],"p":"助動詞","r":"です","s":"です"},{"b":"。","c":false,"f":[{"t":"。"}],"p":"補助記号","r":"","s":"。"},{"b":"お","c":false,"f":[{"t":"お"}],"p":"接頭辞","r":"お","s":"お"},{"b":"ばあ","c":true,"f":[{"t":"ばあ"}],"p":"名詞","r":"ばあ","s":"ばあ"},{"b":"ちゃん","c":false,"f":[{"t":"ちゃん"}],"p":"接尾辞","r":"ちゃん","s":"ちゃん"},{"b":"は","c":false,"f":[{"t":"は"}],"p":"助詞","r":"は","s":"は"},{"b":"、","c":false,"f":[{"t":"、"}],"p":"補助記号","r":"","s":"、"},{"b":"今日","c":true,"f":[{"r":"きょう","t":"今日"}],"p":"名詞","r":"きょう","s":"今日"},{"b":"で","c":false,"f":[{"t":"で"}],"p":"助詞","r":"で","s":"で"},{"b":"七十","c":false,"