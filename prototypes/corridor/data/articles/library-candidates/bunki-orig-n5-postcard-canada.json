ostcard. I am very fine. Japan is cold too.」\n\nたぶん、まちがいがあります。でも、だいじょうぶです。先生も、はじめはわらうでしょう。でも、もういちど読んだとき、わらわないでしょう。\n","textMetrics":{"charsUnit":"unicode-codepoint","readingAnchorUnit":"utf16","tokenPositionUnit":"token-index","utf16Length":701},"title":"カナダからのはがき","titleEn":"A Postcard from Canada","tokens":[{"b":"学校","c":true,"f":[{"r":"がっこう","t":"学校"}],"p":"名詞","r":"がっこう","s":"学校"},{"b":"から","c":false,"f":[{"t":"から"}],"p":"助詞","r":"から","s":"から"},{"b":"かえって","c":true,"f":[{"t":"かえって"}],"p":"副詞","r":"かえって","s":"かえって"},{"b":"、","c":false,"f":[{"t":"、"}],"p":"補助記号","r":"","s":"、"},{"b":"ポスト","c":true,"f":[{"t":"ポスト"}],"p":"名詞","r":"ぽすと","s":"ポスト"},{"b":"を","c":false,"f":[{"t":"を"}],"p":"助詞","r":"を","s":"を"},{"b":"見る","c":true,"f":[{"r":"み","t":"見"}],"p":"動詞","r":"み","s":"見"},{"b":"ます","c":false,"f":[{"t":"まし"}],"p":"助動詞","r":"まし","s":"まし"},{"b":"た","c":false,"f":[{"t":"た"}],"p":"助動詞","r":"た","s":"た"},{"b":"。","c":false,"f":[{"t":"。"}],"p":"補助記号","r":"","s":"。"},{"b":"はがき","c":true,"f":[{"t":"はがき"}],"p":"名詞","r":"はがき","s":"はがき"},{"b":"が","c":false,"f":[{"t":"が"}],"p":"助詞","r":"が","s":"が"},{"b":"一","c":false,"f":[{"r":"いち","t":"一"}],"p":"名詞","r":"いち","s":"一"},{"b":"まい","c":false,"f":[{"t":"まい"}],"p":"接尾辞","r":"まい","s":"まい"},{"b":"ある","c":true,"f":[{"t":"あり"}],"p":"動詞","r":"あり","s":"あり"},{"b":"ます","c":false,"f":[{"t":"まし"}],"p":"助動詞","r":"まし","s":"まし"},{"b":"た","c":false,"f":[{"t":"た"}],"p":"助動詞","r":"た","s":"た"},{"b":"。","c":false,"f":[{"t":"。"}],"p":"補助記号","r":"","s":"。"},{"b":"山","c":true,"f":[{"r":"やま","t":"山"}],"p":"名詞","r":"やま","s":"山"},{"b":"と","c":false,"f":[{"t":"と"}],"p":"助詞","r":"と","s":"と"},{"b":"みずうみ","c":true,"f":[{"t":"みずうみ"}],"p":"名詞","r":"みずうみ","s":"みずうみ"},{"b":"の","c":false,"f":[{"t":"の"}],"p":"助詞","r":"の","s":"の"},{"b":"しゃしん","c":true,"f":[{"t":"しゃしん"}],"p":"名詞","r":"しゃしん","s":"しゃしん"},{"b":"の","c":false,"f":[{"t":"の"}],"p":"助詞","r":"の","s":"の"},{"b":"はがき","c":true,"f":[{"t":"はがき"}],"p":"名詞","r":"はがき","s":"はがき"},{"b":"です","c":false,"f":[{"t":"でし"}],"p"