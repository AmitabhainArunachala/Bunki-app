その魚に「クロ」という名前をつけました。\n\nあれから、五年たちました。クロは、今もげんきです。とても大きくなって、今はぼくの手より大きいです。\n\n今年のおまつりでも、お父さんはきんぎょすくいをやりました。そして、今年も一ぴきもとれませんでした。でも、お父さんはわらって言いました。\n\n「いいんだ。うちには、クロがいるから」\n","textMetrics":{"charsUnit":"unicode-codepoint","readingAnchorUnit":"utf16","tokenPositionUnit":"token-index","utf16Length":583},"title":"なつまつりのきんぎょ","titleEn":"The Festival Goldfish","tokens":[{"b":"なつ休み","c":true,"f":[{"t":"なつ"},{"r":"やす","t":"休"},{"t":"み"}],"p":"名詞","r":"なつやすみ","s":"なつ休み"},{"b":"に","c":false,"f":[{"t":"に"}],"p":"助詞","r":"に","s":"に"},{"b":"、","c":false,"f":[{"t":"、"}],"p":"補助記号","r":"","s":"、"},{"b":"ぼく","c":true,"f":[{"t":"ぼく"}],"p":"代名詞","r":"ぼく","s":"ぼく"},{"b":"は","c":false,"f":[{"t":"は"}],"p":"助詞","r":"は","s":"は"},{"b":"お","c":false,"f":[{"t":"お"}],"p":"接頭辞","r":"お","s":"お"},{"b":"父","c":true,"f":[{"r":"ちち","t":"父"}],"p":"名詞","r":"ちち","s":"父"},{"b":"さん","c":false,"f":[{"t":"さん"}],"p":"接尾辞","r":"さん","s":"さん"},{"b":"と","c":false,"f":[{"t":"と"}],"p":"助詞","r":"と","s":"と"},{"b":"、","c":false,"f":[{"t":"、"}],"p":"補助記号","r":"","s":"、"},{"b":"じんじゃ","c":true,"f":[{"t":"じんじゃ"}],"p":"名詞","r":"じんじゃ","s":"じんじゃ"},{"b":"の","c":false,"f":[{"t":"の"}],"p":"助詞","r":"の","s":"の"},{"b":"お","c":false,"f":[{"t":"お"}],"p":"接頭辞","r":"お","s":"お"},{"b":"まつり","c":true,"f":[{"t":"まつり"}],"p":"名詞","r":"まつり","s":"まつり"},{"b":"に","c":false,"f":[{"t":"に"}],"p":"助詞","r":"に","s":"に"},{"b":"行く","c":true,"f":[{"r":"い","t":"行"},{"t":"き"}],"p":"動詞","r":"いき","s":"行き"},{"b":"ます","c":false,"f":[{"t":"まし"}],"p":"助動詞","r":"まし","s":"まし"},{"b":"た","c":false,"f":[{"t":"た"}],"p":"助動詞","r":"た","s":"た"},{"b":"。","c":false,"f":[{"t":"。"}],"p":"補助記号","r":"","s":"。"},{"b":"ぼく","c":true,"f":[{"t":"ぼく"}],"p":"代名詞","r":"ぼく","s":"ぼく"},{"b":"は","c":false,"f":[{"t":"は"}],"p":"助詞","r":"は","s":"は"},{"b":"七","c":false,"f":[{"r":"なな","t":"七"}],"p":"名詞","r":"なな","s":"七"},{"b":"さい","c":false,"f":[{"t":"さい"}],"p":"接尾辞","r":"さい","s":"さい"},{"b":"です","c":false,"f":[{"t":"でし"}],"p":"助動詞","r":"でし","s":"でし"},{"b":"た","c":false,"f":[{"t":"た"}],"p":"助動