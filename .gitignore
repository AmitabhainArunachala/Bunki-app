# dependencies
node_modules/

# build output
dist/
build/
coverage/
*.tsbuildinfo

# Expo
.expo/
web-build/
expo-env.d.ts
.metro-health-check*

# native projects (generated by prebuild; never committed in Phase 0)
/ios
/android

# secrets — controller §15: no secret in git, ever.
# .env.example IS committed and must contain no real value.
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.key
*.jks
*.mobileprovision

# playwright (WP-10)
playwright-report/
test-results/
blob-report/

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS / editor
.DS_Store
.vscode/
.idea/

# Sites v11 prototype build/runtime outputs
prototypes/bunki-sites-v11/dist/
prototypes/bunki-sites-v11/.vinext/
prototypes/bunki-sites-v11/.sites-runtime/

# Agent worktrees. The Agent tool creates a full nested checkout per isolated
# subagent (this run's independent verifier put 698 MB here). Ephemeral tooling
# state, never a build input. Scoped to worktrees/ rather than all of .claude/
# so real project config under .claude/ stays committable.
.claude/worktrees/

# Throwaway browser probes at the repo root. Playwright only resolves via
# node_modules here, so an ad-hoc `import { chromium } from 'playwright'`
# script cannot live in a temp dir — it has to be written beside package.json
# and deleted afterwards. Ignored so a probe still running (e.g. an independent
# verifier's) never gets committed by accident. Durable tooling belongs in
# prototypes/corridor/tools/, which this does not match.
/*-probe.mjs
