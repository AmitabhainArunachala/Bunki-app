  "journey": [
    { "go": "index.html#/today" }, { "wait": 700 }, { "frame": "Today: the word inks in" },
    { "wait": 1300 }, { "frame": "light runs word → kanji → parts" },
    { "click": ".t-big" }, { "wait": 420 }, { "frame": "Words: web lays out (mid)" },
    { "wait": 900 }, { "click": ".node[data-id='K:記']" }, { "wait": 260 }, { "frame": "re-centring on 記 (mid-move)" },
    { "wait": 1000 }, { "click": ".node[data-id='P:己']" }, { "wait": 1100 }, { "frame": "part 己 — the walk stays lit" },
    { "click": "#tabs [data-go=read]" }, { "wait": 700 }, { "frame": "Read: the shelf" },
    { "click": ".r-open" }, { "wait": 2000 }, { "frame": "article, resumed at the line" },
    { "eval": "[...document.querySelectorAll('.tk.c')].find(e=>e.textContent.startsWith('記憶')).click()" }, { "wait": 300 }, { "frame": "the word lifts out (match-cut)" },
    { "wait": 900 }, { "frame": "word sheet: kanji traced" },
    { "eval": "location.hash='#/learn/front'" }, { "wait": 800 }, { "frame": "Learn: card front on the stage" },
    { "click": ".c-reveal" }, { "wait": 650 }, { "frame": "the beam reads; readings appear" },
    { "wait": 1400 }, { "frame": "card back with shared part" }
  ]
