    { "name": "article", "path": "index.html#/read/article", "settle": 900 },
    { "name": "popup", "path": "index.html#/read/popup", "settle": 2600 },
    { "name": "learn", "path": "index.html#/learn" },
    { "name": "front", "path": "index.html#/learn/front" },
