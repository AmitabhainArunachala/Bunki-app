    { "name": "words-walk", "path": "index.html#/words", "steps": [{ "wait": 1400 }, { "click": ".node[data-id='K:記']" }, { "wait": 1200 }, { "click": ".node[data-id='P:己']" }], "settle": 1600 },
    { "name": "today-ja", "path": "index.html?lang=ja#/today", "settle": 3200 },
    { "name": "learn-ja", "path": "index.html?lang=ja#/learn" },
    { "name": "back-ja", "path": "index.html?lang=ja#/learn/back", "settle": 1800 }
