    "expo-linking": "57.0.4",
    "expo-router": "57.0.8",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "19.2.2"
  }
}
